{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)\\.(mp4|webp|jpg|png|mp3|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "doughssant.com"
        }
      ],
      "destination": "https://www.donutste.com/doughssant/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.doughssant.com"
        }
      ],
      "destination": "https://www.donutste.com/doughssant/",
      "permanent": false
    }
  ]
}